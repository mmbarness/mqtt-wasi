# Plaintext MQTT v5 broker used by the standalone examples.
MQTT_ADDR=127.0.0.1:1883
MQTT_USER=
MQTT_PASS=

# Optional external TLS broker used only by tests/tls_integration.rs and the
# TLS example. These tests skip when any variable is absent.
MQTT_TLS_ADDR=broker.example.com:8883
MQTT_TLS_USER=your-username
MQTT_TLS_PASS=your-password

# CI sets this to make local-broker connection failures fatal instead of skips.
# MQTT_TEST_REQUIRED=1
